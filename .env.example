
# ─── OpenRouter API Key (REQUIRED for AI disease diagnosis) ──────────────────
# 1. Go to: https://openrouter.ai/keys
# 2. Sign in / create account (free tier available)
# 3. Click "Create Key"
# 4. Copy the key — it starts with "sk-or-..."
# 5. Paste it below (replace the placeholder)
OPENROUTER_API_KEY=sk-or-YOUR_KEY_HERE

# ─── Segmentation API (optional — leave empty if not using) ────────────────────
VITE_SEGMENTATION_API_URL=
SEGMENTATION_API_PROXY_TARGET=http://127.0.0.1:8000
