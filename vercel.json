{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/analyze-disease.js": { "maxDuration": 30 },
    "api/health.js": { "maxDuration": 10 }
  }
}
